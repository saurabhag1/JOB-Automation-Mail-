# Copy to .env and fill in. Nothing here is ever committed.

# --- Email channel (same variables the existing bulk_mail_sender uses) ---
EMAIL_ADDRESS=you@gmail.com
# A Gmail App Password (Google Account -> Security -> App passwords), not your login password.
EMAIL_PASSWORD=
# Defaults are Gmail; override for another SMTP provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1

# --- Resume tailoring with Claude (optional) ---
# Without a key the tool still tailors, using deterministic rules (reorder + keyword focus).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
